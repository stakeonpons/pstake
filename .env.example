# Copy to .env.local and fill in. Vite exposes VITE_* to the browser at build time.

# Fee recipient for every token launched through the site. REQUIRED — the build fails without it,
# deliberately: a missing value would launch tokens paying nobody, and the address is written into
# the launch transaction.
#
# It reaches the browser either way, because that transaction is public. Reading it from the
# environment keeps it out of source control, not out of sight.
VITE_FEE_RECIPIENT=

# Comma-separated wallets that see the admin controls. A UI gate only; the registry verifies a
# signature server side.
VITE_ADMIN_WALLETS=

# An extra Robinhood Chain RPC endpoint, tried alongside the public one. Optional.
#
# ⚠ It ships inside the bundle, so a keyed endpoint's quota is spendable by anyone who copies it.
# Restrict it by domain at the provider if it carries a key.
VITE_RHC_RPC=
