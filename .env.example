# Copy to .env.local and fill in. Vite exposes VITE_* to the browser at build time.

# Fee recipient for every token launched through the site. REQUIRED — the build fails without it,
# deliberately: a launched token's fee route is immutable, so a wrong or missing value is permanent.
VITE_FEE_RECIPIENT=

# Comma-separated wallets that see the admin controls. A UI gate only; the registry verifies a
# signature server side.
VITE_ADMIN_WALLETS=

# Archive-capable BSC endpoint, used for historical lookups such as token artwork. Optional:
# without it the app falls back to a public endpoint and artwork lookups degrade.
VITE_ARCHIVE_RPC=
